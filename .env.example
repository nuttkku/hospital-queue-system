# 🌸 ตัวอย่าง environment variables
# คัดลอกไปเป็นไฟล์ .env (ในโฟลเดอร์เดียวกับ docker-compose.yml) แล้วแก้ค่าตามต้องการ

# ---- พอร์ตของแอป ----
APP_PORT=3000

# ---- MariaDB ----
MARIADB_ROOT_PASSWORD=queue_root_pass
MARIADB_DATABASE=hospital_queue
MARIADB_USER=queue_user
MARIADB_PASSWORD=queue_pass

# ---- JWT / Cookie (เปลี่ยนทุกค่าเมื่อใช้งานจริง!) ----
JWT_SECRET=please-change-this-to-a-long-random-string
COOKIE_SECURE=false

# ---- 2FA (TOTP) ----
# ใช้เข้ารหัส TOTP secret ใน MariaDB (ควรเป็น string ยาว ๆ สุ่ม)
TOTP_ENCRYPTION_KEY=please-change-this-2fa-encryption-key-too
TWOFA_ISSUER=HospitalQueue

# ---- บัญชีเริ่มต้น (สร้างเฉพาะตอนที่ยังไม่มีผู้ใช้ในระบบ) ----
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_RECEPTIONIST_USERNAME=receptionist
SEED_RECEPTIONIST_PASSWORD=reception123
SEED_DOCTOR_USERNAME=doctor
SEED_DOCTOR_PASSWORD=doctor123
