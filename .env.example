# 🌸 ตัวอย่าง environment variables
# คัดลอกไปเป็นไฟล์ .env (ในโฟลเดอร์เดียวกับ docker-compose.yml) แล้วแก้ค่าตามต้องการ

# ---- พอร์ตของแอป ----
HTTPS_PORT=443         # Reverse proxy (nginx) — เข้าใช้งานที่ https://localhost
HTTP_PORT=80           # http://localhost -> 301 ไป https
MARIADB_PORT=3306      # Database พอร์ตที่เปิดให้ SQL client จาก host เข้าได้
# BACKEND_PORT=3001    # (optional) ถ้าอยาก debug API ตรง ๆ ให้เปิดคอมเมนต์ใน docker-compose.yml

# ---- MariaDB ----
MARIADB_ROOT_PASSWORD=queue_root_pass
MARIADB_DATABASE=hospital_queue
MARIADB_USER=queue_user
MARIADB_PASSWORD=queue_pass

# ---- JWT / Cookie (เปลี่ยนทุกค่าเมื่อใช้งานจริง!) ----
JWT_SECRET=please-change-this-to-a-long-random-string
# เว็บเป็น HTTPS แล้ว → cookie ต้อง Secure
COOKIE_SECURE=true

# ---- 2FA (TOTP) ----
# ใช้เข้ารหัส TOTP secret ใน MariaDB (ควรเป็น string ยาว ๆ สุ่ม)
TOTP_ENCRYPTION_KEY=please-change-this-2fa-encryption-key-too
TWOFA_ISSUER=HospitalQueue

# ---- AI Chatbot (DeepSeek) ----
# คัดลอก key ไปใส่ในไฟล์ .env (ห้าม commit ขึ้น git!)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ---- Social Login ----
# URL ฐานของเว็บ — Facebook/Google/LINE จะ redirect กลับมาที่ {PUBLIC_BASE_URL}/api/auth/social/callback/{provider}
PUBLIC_BASE_URL=https://localhost

# ---- บัญชีเริ่มต้น (สร้างเฉพาะตอนที่ยังไม่มีผู้ใช้ในระบบ) ----
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_RECEPTIONIST_USERNAME=receptionist
SEED_RECEPTIONIST_PASSWORD=reception123
SEED_DOCTOR_USERNAME=doctor
SEED_DOCTOR_PASSWORD=doctor123
